<Window x:Class="DairyProductInventoryApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Облік молочних продуктів" Height="600" Width="800">
    <Window.Resources>
        <!-- Стиль для текстових полів -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F5F6F5"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#357ABD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A6099"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль для підписів -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E2E2E"/>
        </Style>
        <!-- Стиль для DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#F9F9F9"/>
            <Setter Property="AlternatingRowBackground" Value="#E8F0FA"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E6F0FA" Offset="0"/>
                <GradientStop Color="#F5F6F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Підписи для пошуку -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,5">
            <Label Content="Тип продукту:" Width="150" Margin="5"/>
            <Label Content="Назва продукту:" Width="150" Margin="5"/>
            <Label Content="Бренд:" Width="150" Margin="5"/>
            <Label Content="" Width="100" Margin="5"/>
        </StackPanel>

        <!-- Пошук -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <TextBox Width="150" Margin="5" Text="{Binding SearchType, UpdateSourceTrigger=PropertyChanged}" ToolTip="Тип (Milk, Cheese, Yogurt)"/>
            <TextBox Width="150" Margin="5" Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Назва"/>
            <TextBox Width="150" Margin="5" Text="{Binding SearchBrand, UpdateSourceTrigger=PropertyChanged}" ToolTip="Бренд"/>
            <Button Content="Пошук" Width="100" Margin="5" Command="{Binding SearchCommand}"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10">
            <Button Content="Додати" Width="100" Margin="5" Command="{Binding AddCommand}"/>
            <Button Content="Редагувати" Width="100" Margin="5" Command="{Binding EditCommand}"/>
            <Button Content="Видалити" Width="100" Margin="5" Command="{Binding DeleteCommand}"/>
        </StackPanel>

        <!-- Таблиця -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" 
                  AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}"/>
                <DataGridTextColumn Header="Назва" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}"/>
                <DataGridTextColumn Header="Упаковка" Binding="{Binding Packaging}"/>
                <DataGridTextColumn Header="Жирність (%)" Binding="{Binding FatContent}"/>
                <DataGridTextColumn Header="Вага/Об'єм" Binding="{Binding WeightOrVolume}"/>
                <DataGridTextColumn Header="Термін придатності" Binding="{Binding ExpiryDate, StringFormat=d}"/>
                <DataGridTextColumn Header="Ціна (грн)" Binding="{Binding Price}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>