<Window x:Class="DairyProductInventoryApp.Views.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продукт" Height="400" Width="400">
    <Window.Resources>
        <!-- Стиль для текстових полів -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F5F6F5"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#357ABD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A6099"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль для підписів -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E2E2E"/>
        </Style>
        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F5F6F5"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- Стиль для DatePicker -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#F5F6F5"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E6F0FA" Offset="0"/>
                <GradientStop Color="#F5F6F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Назва:" Grid.Row="0"/>
        <TextBox Grid.Row="0" Margin="100,0,10,5" Text="{Binding Name}"/>

        <Label Content="Бренд:" Grid.Row="1"/>
        <TextBox Grid.Row="1" Margin="100,0,10,5" Text="{Binding Brand}"/>

        <Label Content="Упаковка:" Grid.Row="2"/>
        <TextBox Grid.Row="2" Margin="100,0,10,5" Text="{Binding Packaging}"/>

        <Label Content="Жирність (%):" Grid.Row="3"/>
        <TextBox Grid.Row="3" Margin="100,0,10,5" Text="{Binding FatContent}"/>

        <Label Content="Вага/Об'єм:" Grid.Row="4"/>
        <TextBox Grid.Row="4" Margin="100,0,10,5" Text="{Binding WeightOrVolume}"/>

        <Label Content="Ціна (грн):" Grid.Row="5"/>
        <TextBox Grid.Row="5" Margin="100,0,10,5" Text="{Binding Price}"/>

        <Label Content="Термін придатності:" Grid.Row="6"/>
        <DatePicker Grid.Row="6" Margin="100,0,10,5" SelectedDate="{Binding ExpiryDate}"/>

        <Label Content="Тип:" Grid.Row="7"/>
        <ComboBox Grid.Row="7" Margin="100,0,10,5" ItemsSource="{Binding Types}" 
                  SelectedItem="{Binding SelectedType}"/>

        <Button Content="Зберегти" Grid.Row="8" Margin="10,10,10,0" Command="{Binding SaveCommand}"/>
    </Grid>
</Window>